# === M-Pesa Daraja (Safaricom) ===
# Get these free from developer.safaricom.co.ke after creating a sandbox app
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                  # the school's paybill number
MPESA_PASSKEY=                    # only needed for STK push, not for C2B ingestion
MPESA_CONFIRMATION_URL=https://your-domain.example.com/webhooks/mpesa/confirmation
MPESA_VALIDATION_URL=https://your-domain.example.com/webhooks/mpesa/validation

# === Equity (Jenga API / Finserve Africa) ===
JENGA_ENV=sandbox                 # sandbox | production
JENGA_API_KEY=
JENGA_MERCHANT_CODE=
JENGA_ACCOUNT_NUMBER=             # the school's Equity account number
JENGA_PRIVATE_KEY_PATH=           # path to .pem private key used to sign requests

# === Database (Postgres) ===
# Get a free connection string from neon.com (recommended - free forever,
# no forced expiry) or supabase.com. Format looks like:
# postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# === Secrets (REQUIRED - the server will not start without them) ===
# Generate EACH one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two different values. Never share or commit them. If you lose
# ENCRYPTION_KEY, stored bank credentials can no longer be read.
JWT_SECRET=
ENCRYPTION_KEY=

# === App ===
PORT=3000

# === Dev routes ===
# /api/dev/reset WIPES THE DATABASE and /api/dev/seed-school is unauthenticated.
# Both are OFF unless you set this to true, and never work when NODE_ENV=production.
# Only turn on for local testing (src/scripts/test-local.js needs it).
ENABLE_DEV_ROUTES=false


# === Email (invites and password links) ===
# Where people open the app. Used inside the emailed links. Local: http://localhost:3000
APP_URL=http://localhost:3000
# Leave these three empty while testing on your own computer (links show on the Staff page instead).
# For real: a free Resend or Brevo account, a verified sender address, then fill all three.
MAIL_PROVIDER=          # resend | brevo
MAIL_API_KEY=
MAIL_FROM=              # e.g. Karo Recon <no-reply@yourdomain.co.ke>


# ---- Parent portal ----
# The public https address of this server (no "mpesa" in it). Safaricom posts the STK push result here, and the
# portal link in texts uses it. While testing on your own computer use a tunnel address (ngrok / cloudflared).
PUBLIC_BASE_URL=
# Parents sign in with a code sent by text message, through Celcom Africa (dashboard: "Get API key & Partner ID").
# SMS_SENDER_ID is your approved sender name (Celcom calls it the shortcode). SMS_URL only if Celcom gave you another address.
# Leave SMS_PROVIDER empty to send nothing: the code is then printed in the terminal and shown on the sign-in screen.
SMS_PROVIDER=
SMS_API_KEY=
SMS_PARTNER_ID=
SMS_SENDER_ID=
SMS_URL=
# true = also print every text (so the sign-in code) in the terminal even in production. Outside production it always prints.
SMS_PRINT_CODE=
# Optional: the most a parent can pay in one M-Pesa request (default 150000)
STK_MAX_AMOUNT=
